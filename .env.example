# Copied to .env by `npm run setup`, which fills the blank secrets with random values.
# .env is git-ignored. Never commit real keys.

NODE_ENV=development
API_PORT=4000
ADMIN_ORIGIN=http://localhost:3001
BUSINESS_ORIGIN=http://localhost:3002
WORKER_WEB_ORIGIN=http://localhost:8081

DATABASE_URL=postgres://shiftkart:shiftkart@localhost:5433/shiftkart
DATABASE_URL_TEST=postgres://shiftkart:shiftkart@localhost:5433/shiftkart_test

# 32-byte keys, base64. DATA_KEY encrypts personal data at rest; HASH_KEY makes lookup hashes.
DATA_KEY=
HASH_KEY=

# Password for the seeded local staff accounts (generated by setup).
SEED_STAFF_PASSWORD=

# Dev-only endpoints (mock SMS outbox). Always off in production.
DEV_ENDPOINTS=true

# All external providers are mocks until you approve a sandbox (see docs/DECISIONS.md).
SMS_PROVIDER=mock
PAYMENTS_PROVIDER=mock
KYC_PROVIDER=mock

# Secret the mock payment provider signs webhooks with (generated by setup).
MOCKPAY_WEBHOOK_SECRET=

# Production only. Number of proxies in front of the API (e.g. 1 behind a load balancer). Leave unset locally.
# TRUST_PROXY=1

# DPDP grievance officer shown in the apps. Production refuses to start without these (LEGAL L-22).
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
